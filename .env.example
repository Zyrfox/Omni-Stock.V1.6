# ============================================
# OMNI-STOCK V1.5 — Environment Variables
# Easy Going Group · Phase 1
# ============================================
# Copy file ini jadi .env.local lalu isi semua value-nya.
# Jangan pernah commit .env.local ke repository!
# ============================================

# ──────────────────────────────────────────
# DATABASE — Supabase PostgreSQL
# ──────────────────────────────────────────
# Direct connection string (port 5432), bukan pooler.
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL=

# ──────────────────────────────────────────
# SUPABASE — Client & Server Keys
# ──────────────────────────────────────────
# Project URL dari Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co

# Anon / Public key — aman diekspos di client-side
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service Role key — HANYA server-side, jangan pernah ekspos ke client
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────
# AUTH — Better Auth + Google SSO
# ──────────────────────────────────────────
# Google OAuth dari Google Cloud Console → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret untuk signing JWT session Better Auth (generate random 32+ char)
# Contoh generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# ──────────────────────────────────────────
# AI ENGINE — Google Gemini API
# ──────────────────────────────────────────
# API Key dari Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# ──────────────────────────────────────────
# GOOGLE SHEETS — One-Time Migration
# ──────────────────────────────────────────
# JSON string Service Account key untuk Google Sheets API
# Paste seluruh isi file .json sebagai single-line string
GSHEET_SERVICE_ACCOUNT_KEY=

# Spreadsheet ID sumber data lama (dari URL Google Sheets)
# Contoh: https://docs.google.com/spreadsheets/d/[INI_ID_NYA]/edit
GSHEET_SPREADSHEET_ID=

# ──────────────────────────────────────────
# APP — General
# ──────────────────────────────────────────
# Base URL deployment (tanpa trailing slash)
# Development: http://localhost:3000
# Production:  https://omni-stock.vercel.app (sesuaikan)
NEXT_PUBLIC_APP_URL=http://localhost:3000
